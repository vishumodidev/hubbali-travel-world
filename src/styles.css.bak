/* ============ TOKENS ============ */
:root{
  --gold:#f2a900; --gold-dark:#d28f00; --navy:#0f2233; --navy-2:#16324a;
  --cream:#fbf7ef; --text:#33414d; --muted:#7b8794; --white:#fff;
  --radius:18px; --shadow:0 10px 30px rgba(15,34,51,.12);
  /* Replace these with your own photos, e.g. url("images/hampi.jpg") */
  --img-hero: none; --img-hampi: none; --img-goa: none; --img-coorg: none;
  --img-ooty: none; --img-mysore: none;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Poppins',sans-serif;color:var(--text);background:var(--white);overflow-x:hidden}
a{text-decoration:none;color:inherit}
ul{list-style:none}
.container{width:min(1180px,92%);margin-inline:auto}
.eyebrow{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-dark);font-weight:600}
h2.title{font-family:'Playfair Display',serif;font-size:clamp(1.7rem,3vw,2.3rem);color:var(--navy);margin:.3rem 0 .5rem}
.script{font-family:'Caveat',cursive}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.5rem;border-radius:999px;font-weight:600;font-size:.9rem;border:0;cursor:pointer;transition:.3s;position:relative;overflow:hidden}
.btn-gold{background:var(--gold);color:var(--navy)}
.btn-gold:hover{background:var(--gold-dark);transform:translateY(-3px);box-shadow:0 10px 20px rgba(242,169,0,.4)}
.btn-gold .arrow{transition:transform .3s}
.btn-gold:hover .arrow{transform:translateX(5px)}
.btn-dark{background:var(--navy);color:#fff}
.btn-dark:hover{background:var(--navy-2);transform:translateY(-3px)}
/* Shine sweep */
.btn::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.45) 50%,transparent 70%);transform:translateX(-120%)}
.btn:hover::after{transform:translateX(120%);transition:transform .7s}

/* ============ HEADER ============ */
header{position:fixed;top:0;left:0;width:100%;z-index:100;background:rgba(255,255,255,.95);backdrop-filter:blur(10px);transition:.3s;animation:slideDown .8s ease both}
header.scrolled{box-shadow:0 5px 25px rgba(0,0,0,.1)}
.nav{display:flex;align-items:center;justify-content:space-between;height:70px}
.logo{display:flex;align-items:center;gap:.6rem}
.logo-mark{width:44px;height:44px;border-radius:50%;border:3px solid var(--gold);display:grid;place-items:center;font-family:'Playfair Display',serif;font-weight:700;color:var(--navy)}
.logo b{font-family:'Playfair Display',serif;font-size:1.35rem;color:var(--navy);display:block;line-height:1}
.logo small{font-size:.58rem;color:var(--gold-dark);letter-spacing:.12em;font-weight:600}
.menu{display:flex;gap:1.8rem;font-size:.85rem;font-weight:500}
.menu a{position:relative;padding:.4rem 0}
.menu a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--gold);transition:width .3s}
.menu a:hover::after,.menu a.active::after{width:100%}
.nav-right{display:flex;align-items:center;gap:1.2rem;font-size:.85rem;font-weight:500}
.burger{display:none;background:none;border:0;font-size:1.6rem;cursor:pointer}

/* ============ HERO ============ */
.hero{position:relative;min-height:600px;padding-top:70px;display:flex;align-items:center;color:#fff;
  background:var(--img-hero), linear-gradient(160deg,#ff9a4d 0%,#e0654a 28%,#5b4a7a 55%,#1e4f5c 80%,#16324a 100%);
  background-size:cover;background-position:center;
  clip-path:ellipse(120% 100% at 50% 0%);padding-bottom:90px;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,20,30,.65),transparent 65%)}
.hero .sun{position:absolute;right:18%;top:90px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,#ffe29a,#ffb347 55%,transparent 70%);filter:blur(4px);animation:pulse 5s ease-in-out infinite}
.hero .mountains{position:absolute;bottom:0;left:0;width:100%;height:45%;opacity:.5;
  background:linear-gradient(to top,#0b2a33,transparent);}
.hero-inner{position:relative;z-index:2;max-width:560px}
.hero .eyebrow{color:#fff;font-size:.7rem}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(2.4rem,5vw,3.8rem);line-height:1.1;margin:.8rem 0 1rem}
.hero p{font-size:.95rem;opacity:.92;max-width:440px;margin-bottom:1.8rem}
.hero-btns{display:flex;align-items:center;gap:1.1rem;flex-wrap:wrap}
.play{display:inline-flex;align-items:center;gap:.7rem;font-weight:500;font-size:.85rem;cursor:pointer}
.play i{width:46px;height:46px;border-radius:50%;background:#fff;color:var(--navy);display:grid;place-items:center;font-style:normal;position:relative}
.play i::before{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid #fff;animation:ripple 2s infinite}
.hero-quote{position:absolute;right:6%;top:150px;z-index:2;font-size:2.4rem;line-height:1;transform:rotate(-8deg);text-align:center;animation:float 5s ease-in-out infinite}
.plane{position:absolute;font-size:2rem;z-index:2;right:4%;top:120px;animation:fly 9s linear infinite}

/* Search box */
.search-wrap{position:relative;z-index:5;margin-top:-62px}
.search{background:#fff;border-radius:20px;box-shadow:var(--shadow);padding:1rem 1.4rem;display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:1rem;align-items:center;animation:fadeUp 1s .5s both}
.field{display:flex;gap:.8rem;align-items:center;padding:0 .5rem;border-right:1px solid #eee}
.field:nth-child(3){border-right:0}
.field span.ic{font-size:1.4rem;color:var(--navy)}
.field label{display:block;font-size:.8rem;font-weight:600;color:var(--navy)}
.field input,.field select{border:0;outline:0;font:inherit;font-size:.78rem;color:var(--muted);width:100%;background:transparent}

/* ============ DESTINATIONS ============ */
section{padding:70px 0}
.dest-head{display:flex;justify-content:space-between;align-items:flex-end}
.dest-head .script{font-size:1.8rem;color:var(--navy);transform:rotate(-5deg);display:inline-block}
.carousel{position:relative;margin-top:2rem}
.track{display:flex;gap:1.1rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px 4px 16px}
.track::-webkit-scrollbar{display:none}
.dest{flex:0 0 calc(20% - 1rem);min-width:190px;height:260px;border-radius:22px;position:relative;overflow:hidden;scroll-snap-align:start;color:#fff;cursor:pointer;transition:.4s;box-shadow:var(--shadow)}
.dest .bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .7s}
.dest:hover .bg{transform:scale(1.12)}
.dest:hover{transform:translateY(-8px)}
.dest::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(10,20,30,.85),transparent 55%)}
.dest .info{position:absolute;left:14px;right:14px;bottom:14px;z-index:2;display:flex;justify-content:space-between;align-items:center}
.dest h4{font-size:.95rem;font-weight:600}
.dest small{font-size:.72rem;opacity:.85}
.dest .go{width:30px;height:30px;border-radius:50%;background:var(--gold);color:var(--navy);display:grid;place-items:center;font-weight:700;transition:.3s}
.dest:hover .go{transform:rotate(-45deg) scale(1.1)}
.d1 .bg{background:var(--img-hampi),linear-gradient(135deg,#c98a4b,#7a4a24)}
.d2 .bg{background:var(--img-goa),linear-gradient(135deg,#2ec4d6,#1b7aa6 60%,#f2c76e)}
.d3 .bg{background:var(--img-coorg),linear-gradient(135deg,#9bb0b8,#3e6b5c)}
.d4 .bg{background:var(--img-ooty),linear-gradient(135deg,#7fc47f,#2f7a4f)}
.d5 .bg{background:var(--img-mysore),linear-gradient(135deg,#e8c27a,#a86a2a)}
.arrow-btn{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;background:#fff;border:0;box-shadow:var(--shadow);cursor:pointer;font-size:1.1rem;z-index:3;transition:.3s}
.arrow-btn:hover{background:var(--gold)}
.arrow-btn.prev{left:-14px}.arrow-btn.next{right:-14px}

/* ============ WHY ============ */
.why{background:linear-gradient(rgba(15,34,51,.82),rgba(15,34,51,.82)),linear-gradient(135deg,#1e4f5c,#6b5b3a);color:#fff;padding:60px 0}
.why .wrap{display:flex;align-items:center;gap:3rem;flex-wrap:wrap}
.note{background:#fbf3df;color:var(--navy);padding:1.6rem 1.8rem;transform:rotate(-5deg);box-shadow:0 12px 25px rgba(0,0,0,.35);font-size:1.7rem;line-height:1.1;max-width:230px;animation:float 6s ease-in-out infinite}
.why-list{display:flex;flex:1;justify-content:space-around;gap:1.2rem;flex-wrap:wrap;text-align:center}
.why-item{max-width:140px;transition:.3s}
.why-item:hover{transform:translateY(-8px)}
.why-ic{width:60px;height:60px;border-radius:50%;border:2px solid var(--gold);color:var(--gold);display:grid;place-items:center;font-size:1.6rem;margin:0 auto .7rem;transition:.3s}
.why-item:hover .why-ic{background:var(--gold);color:var(--navy);transform:rotateY(360deg)}
.why-item h5{font-size:.88rem;font-weight:600}
.why-item p{font-size:.72rem;opacity:.8}

/* ============ ABOUT ============ */
.about{background:var(--cream)}
.about .grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}
.polaroid{background:#fff;padding:12px 12px 36px;box-shadow:var(--shadow);transform:rotate(-6deg);max-width:420px;transition:.5s}
.polaroid:hover{transform:rotate(0) scale(1.03)}
.polaroid .pic{height:260px;background:var(--img-hampi),linear-gradient(135deg,#d49a5a,#7a4a24)}
.about p{font-size:.9rem;margin:1rem 0 1.5rem;line-height:1.8}
.about .script.side{position:absolute;right:0;top:0;font-size:1.7rem;color:var(--navy);transform:rotate(6deg)}
.about .txt{position:relative;padding-right:110px}

/* ============ PACKAGES ============ */
.pk-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem}
.pk-head a{font-size:.85rem;font-weight:500;color:var(--navy)}
.pk-head a:hover{color:var(--gold-dark)}
.packages{display:grid;grid-template-columns:repeat(4,1fr);gap:1.3rem}
.pkg{background:#fff;border-radius:var(--radius);padding:10px 10px 18px;box-shadow:var(--shadow);transition:.4s}
.pkg:hover{transform:translateY(-10px);box-shadow:0 20px 40px rgba(15,34,51,.2)}
.pkg .img{height:150px;border-radius:12px;overflow:hidden;position:relative}
.pkg .img i{position:absolute;inset:0;transition:transform .6s}
.pkg:hover .img i{transform:scale(1.12)}
.pkg .meta{font-size:.72rem;color:var(--muted);margin:.9rem 8px .2rem}
.pkg h4{font-size:.92rem;color:var(--navy);margin:0 8px}
.pkg .price{font-size:.95rem;font-weight:600;color:var(--gold-dark);margin:.3rem 8px}
.pkg .price small{color:var(--muted);font-weight:400;font-size:.7rem}
.pkg .inc{display:flex;gap:.6rem;font-size:.68rem;color:var(--muted);margin:.6rem 8px 1rem}
.pkg .btn{margin-left:8px;padding:.45rem 1.1rem;font-size:.75rem}

/* ============ GALLERY ============ */
.gallery{background:var(--navy);color:#fff;position:relative;overflow:hidden}
.gallery .grid{display:grid;grid-template-columns:1fr 1.6fr;gap:3rem;align-items:center}
.gallery h2.title{color:#fff}
.gallery p{font-size:.9rem;opacity:.85;margin-bottom:1.5rem}
.mosaic{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.mosaic div{height:120px;border-radius:10px;overflow:hidden;position:relative;cursor:pointer}
.mosaic div::before{content:"";position:absolute;inset:0;background:inherit;transition:transform .6s}
.mosaic div:hover::before{transform:scale(1.2)}
.m1{background:linear-gradient(135deg,#ff9a4d,#5b4a7a)}.m2{background:linear-gradient(135deg,#2ec4d6,#1b7aa6)}
.m3{background:linear-gradient(135deg,#e8c27a,#5b7a4f)}.m4{background:linear-gradient(135deg,#c98a4b,#7a4a24)}
.m5{background:linear-gradient(135deg,#7fc47f,#2f7a4f)}
.m6{background:#0b1a28;border:2px solid var(--gold);display:grid;place-items:center;font-size:.8rem;text-align:center}
.m6::before{display:none}
.m6 span{position:relative;z-index:2}
.m6 b{display:block;font-size:1.6rem;margin-bottom:.2rem}

/* ============ TESTIMONIALS ============ */
.t-wrap{overflow:hidden;margin-top:1.5rem}
.t-track{display:flex;transition:transform .6s ease}
.t-card{flex:0 0 33.333%;padding:0 .6rem}
.t-card .in{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);padding:1.4rem;display:flex;gap:1rem;height:100%}
.avatar{width:54px;height:54px;border-radius:50%;flex:none;display:grid;place-items:center;font-weight:600;color:#fff}
.t-card p{font-size:.78rem;line-height:1.6;color:var(--text)}
.t-card h6{font-size:.82rem;margin-top:.6rem;color:var(--navy)}
.stars{color:var(--gold);letter-spacing:2px;font-size:.85rem}
.dots{display:flex;justify-content:center;gap:.5rem;margin-top:1.4rem}
.dots span{width:8px;height:8px;border-radius:50%;background:#ddd;cursor:pointer;transition:.3s}
.dots span.on{background:var(--gold);width:22px;border-radius:8px}

/* ============ CTA ============ */
.cta{position:relative;color:var(--navy);padding:60px 0;
  background:linear-gradient(90deg,rgba(255,255,255,.95) 35%,rgba(255,255,255,.2)),linear-gradient(135deg,#9bb0b8,#e2a35a 60%,#3e6b5c)}
.cta h3{font-family:'Playfair Display',serif;font-size:1.9rem;margin:.4rem 0}
.cta p{font-size:.85rem;max-width:380px;margin-bottom:1.2rem}
.cta .script{position:absolute;right:8%;bottom:35px;color:#fff;font-size:1.8rem;transform:rotate(-8deg);text-shadow:0 2px 8px rgba(0,0,0,.4)}

/* ============ FOOTER ============ */
footer{background:var(--navy);color:#cfd8df;padding-top:50px;font-size:.8rem}
.f-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.4fr .8fr;gap:2rem}
footer h5{color:#fff;font-size:.85rem;margin-bottom:1rem}
footer li{margin-bottom:.6rem;transition:.3s}
footer li:hover{color:var(--gold);transform:translateX(4px)}
footer .logo b{color:#fff}
.socials{display:flex;gap:.6rem}
.socials a{width:34px;height:34px;border-radius:50%;border:1px solid #3a5166;display:grid;place-items:center;transition:.3s}
.socials a:hover{background:var(--gold);color:var(--navy);transform:translateY(-4px)}
.copy{display:flex;justify-content:space-between;border-top:1px solid #243a4d;margin-top:2.5rem;padding:1.1rem 0;font-size:.72rem}
.totop{position:fixed;right:22px;bottom:22px;width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--navy);display:grid;place-items:center;font-weight:700;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.3s;z-index:90}
.totop.show{opacity:1;pointer-events:auto;animation:bounce 2s infinite}

/* ============ ANIMATIONS ============ */
@keyframes slideDown{from{transform:translateY(-100%)}to{transform:none}}
@keyframes fadeUp{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}
@keyframes float{0%,100%{transform:translateY(0) rotate(var(--r,-6deg))}50%{transform:translateY(-14px) rotate(var(--r,-6deg))}}
@keyframes fly{0%{transform:translate(120px,40px) rotate(10deg);opacity:0}15%{opacity:1}85%{opacity:1}100%{transform:translate(-80px,-30px) rotate(-5deg);opacity:0}}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.9}50%{transform:scale(1.15);opacity:1}}
@keyframes ripple{0%{transform:scale(1);opacity:.8}100%{transform:scale(1.7);opacity:0}}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.hero-inner > *{animation:fadeUp .9s both}
.hero-inner .eyebrow{animation-delay:.2s}.hero-inner h1{animation-delay:.35s}
.hero-inner p{animation-delay:.5s}.hero-inner .hero-btns{animation-delay:.65s}
.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s ease,transform .9s ease}
.reveal.in{opacity:1;transform:none}
.reveal.left{transform:translateX(-50px)}.reveal.right{transform:translateX(50px)}
.reveal.left.in,.reveal.right.in{transform:none}
.delay1{transition-delay:.12s}.delay2{transition-delay:.24s}.delay3{transition-delay:.36s}.delay4{transition-delay:.48s}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}

/* ============ RESPONSIVE ============ */
@media(max-width:960px){
  .menu{position:absolute;top:70px;left:0;right:0;background:#fff;flex-direction:column;gap:0;padding:.5rem 5%;max-height:0;overflow:hidden;transition:.4s;box-shadow:0 10px 20px rgba(0,0,0,.08)}
  .menu.open{max-height:360px}.menu a{padding:.9rem 0;border-bottom:1px solid #f0f0f0}
  .burger{display:block}.nav-right .phone{display:none}
  .search{grid-template-columns:1fr 1fr}.field{border:0}
  .packages{grid-template-columns:repeat(2,1fr)}
  .about .grid,.gallery .grid{grid-template-columns:1fr}
  .about .txt{padding-right:0}.about .script.side{display:none}
  .t-card{flex:0 0 100%}
  .f-grid{grid-template-columns:1fr 1fr}
  .hero-quote{display:none}
}
@media(max-width:560px){
  .search{grid-template-columns:1fr}.packages{grid-template-columns:1fr}
  .nav-right .btn{display:none}.copy{flex-direction:column;gap:.5rem}
}
